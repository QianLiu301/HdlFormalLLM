#!/bin/sh
# Refuse commits that contain credentials (tools/check_secrets.py).
# Enable once per clone:  git config core.hooksPath .githooks
PY=$(command -v python3 || command -v python)
[ -z "$PY" ] && { echo "pre-commit: no python found, secret check skipped" >&2; exit 0; }
exec "$PY" "$(git rev-parse --show-toplevel)/tools/check_secrets.py"
